@model baitap.Models.Course

@{
    ViewData["Title"] = "Xóa học phần";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 text-center">
                <div class="text-danger mb-4">
                    <i class="bi bi-exclamation-triangle-fill display-1"></i>
                </div>
                
                <h2 class="fw-bold text-dark mb-3">Xóa Học Phần?</h2>
                <p class="text-muted mb-4">Bạn có chắc chắn muốn xóa học phần này? Hành động này không thể hoàn tác.</p>
                
                <div class="card bg-light border-0 rounded-3 p-4 mb-4 text-start">
                    <h5 class="fw-bold text-dark mb-2">@Model.Name</h5>
                    <div class="text-secondary mb-2">
                        <strong>Mã học phần:</strong> @Model.Id
                    </div>
                    <div class="text-secondary mb-2">
                        <strong>Số tín chỉ:</strong> @Model.Credits tín chỉ
                    </div>
                    <div class="text-secondary mb-2">
                        <strong>Giảng viên:</strong> @Model.Lecturer
                    </div>
                    <div class="text-secondary">
                        <strong>Loại học phần:</strong> @Model?.Category?.Name
                    </div>
                </div>

                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex gap-3 justify-content-center">
                        <a asp-action="Index" class="btn btn-light btn-lg rounded-pill px-4 flex-grow-1">Hủy bỏ</a>
                        <button type="submit" class="btn btn-danger btn-lg rounded-pill px-4 flex-grow-1">Xác nhận xóa</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
