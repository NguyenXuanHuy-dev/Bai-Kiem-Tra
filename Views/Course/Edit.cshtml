@model baitap.Models.Course

@{
    ViewData["Title"] = "Chỉnh sửa học phần";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <div class="mb-4">
                <a asp-action="Index" class="text-decoration-none text-muted">
                    <i class="bi bi-arrow-left"></i> Quay lại danh sách
                </a>
            </div>

            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">
                <div class="mb-4">
                    <h2 class="fw-bold text-dark mb-1">Chỉnh Sửa Học Phần</h2>
                    <p class="text-muted">Cập nhật thông tin học phần đào tạo</p>
                    <hr />
                </div>

                <form asp-action="Edit" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="Image" />

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold"></label>
                        <input asp-for="Name" class="form-control form-control-lg rounded-3" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Credits" class="form-label fw-semibold"></label>
                            <input asp-for="Credits" class="form-control form-control-lg rounded-3" type="number" min="1" max="10" />
                            <span asp-validation-for="Credits" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="CategoryId" class="form-label fw-semibold"></label>
                            <select asp-for="CategoryId" class="form-select form-select-lg rounded-3" asp-items="ViewBag.CategoryId"></select>
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Lecturer" class="form-label fw-semibold"></label>
                        <input asp-for="Lecturer" class="form-control form-control-lg rounded-3" />
                        <span asp-validation-for="Lecturer" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Hình ảnh hiện tại</label>
                        <div class="mb-2">
                            @if (!string.IsNullOrEmpty(Model.Image))
                            {
                                <img src="@Model.Image" class="img-thumbnail rounded-3 object-fit-cover" style="max-height: 150px;" alt="@Model.Name" onerror="this.src='https://placehold.co/300x150?text=No+Image'" />
                            }
                            else
                            {
                                <p class="text-muted small">Không có hình ảnh hiện tại</p>
                            }
                        </div>
                        <label class="form-label fw-semibold">Thay đổi hình ảnh minh họa</label>
                        <input type="file" name="imageFile" class="form-control rounded-3" accept="image/*" />
                        <small class="form-text text-muted">Chọn tệp ảnh mới để thay thế hình ảnh hiện tại.</small>
                    </div>

                    <div class="d-grid mt-4">
                        <button type="submit" class="btn btn-warning btn-lg text-white rounded-pill shadow-sm">
                            <i class="bi bi-save"></i> Lưu thay đổi
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
