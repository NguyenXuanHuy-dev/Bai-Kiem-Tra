@model IEnumerable<baitap.Models.Course>
@{
    ViewData["Title"] = "Quản lý học phần";
}

<div class="container py-4">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4">
        <div>
            <h1 class="h2 fw-bold text-dark mb-1">Quản Lý Học Phần</h1>
            <p class="text-muted mb-0">Thêm, chỉnh sửa hoặc xóa các học phần trong hệ thống đào tạo</p>
        </div>
        <a asp-action="Create" class="btn btn-primary btn-pill shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Thêm Học Phần Mới
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-3 overflow-hidden bg-white">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-secondary">
                    <tr>
                        <th class="py-3 ps-4 text-uppercase fw-bold" style="font-size: 0.75rem; letter-spacing: 0.5px;">Hình ảnh</th>
                        <th class="py-3 text-uppercase fw-bold" style="font-size: 0.75rem; letter-spacing: 0.5px;">Tên học phần</th>
                        <th class="py-3 text-uppercase fw-bold" style="font-size: 0.75rem; letter-spacing: 0.5px;">Loại học phần</th>
                        <th class="py-3 text-uppercase fw-bold" style="font-size: 0.75rem; letter-spacing: 0.5px;">Số tín chỉ</th>
                        <th class="py-3 text-uppercase fw-bold" style="font-size: 0.75rem; letter-spacing: 0.5px;">Giảng viên</th>
                        <th class="py-3 text-end pe-4 text-uppercase fw-bold" style="font-size: 0.75rem; letter-spacing: 0.5px;">Hành động</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-3 text-secondary"></i>
                                Không có học phần nào hiện tại.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    @if (!string.IsNullOrEmpty(item.Image))
                                    {
                                        <img src="@item.Image" class="rounded object-fit-cover" style="width: 60px; height: 45px; border: 1px solid var(--border-color);" alt="@item.Name" onerror="this.src='https://placehold.co/100x70?text=No+Image'" />
                                    }
                                    else
                                    {
                                        <div class="rounded d-flex align-items-center justify-content-center text-white font-weight-bold" style="width: 60px; height: 45px; background: linear-gradient(135deg, #cbd5e1, #94a3b8); font-size: 0.8rem;">
                                            N/A
                                        </div>
                                    }
                                </td>
                                <td class="fw-bold text-dark">@item.Name</td>
                                <td>
                                    <span class="badge bg-light text-primary border border-primary-subtle px-3 py-2 rounded-pill">
                                        @item.Category?.Name
                                    </span>
                                </td>
                                <td>
                                    <span class="badge badge-credits">
                                        @item.Credits Tín chỉ
                                    </span>
                                </td>
                                <td class="text-secondary fw-medium">@item.Lecturer</td>
                                <td class="text-end pe-4">
                                    <div class="d-inline-flex gap-2">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-pill btn-sm px-3">
                                            <i class="bi bi-pencil me-1"></i> Sửa
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-pill btn-sm px-3">
                                            <i class="bi bi-trash me-1"></i> Xóa
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
