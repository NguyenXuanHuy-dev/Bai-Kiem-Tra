@{
    ViewData["Title"] = "Từ chối truy cập";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-5">
                <div class="text-danger mb-4">
                    <i class="bi bi-shield-lock-fill display-1"></i>
                </div>
                <h1 class="fw-bold text-dark mb-3">Từ Chối Truy Cập</h1>
                <p class="text-muted mb-4">Bạn không có quyền truy cập vào chức năng này. Vui lòng liên hệ với quản trị viên nếu bạn tin rằng đây là một sự nhầm lẫn.</p>
                <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg rounded-pill px-4">Quay lại Trang chủ</a>
                </div>
            </div>
        </div>
    </div>
</div>
