@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-5 col-md-7 col-sm-9">
            <div class="card border-0 auth-card p-4 p-md-5">
                <div class="text-center mb-4">
                    <h2 class="fw-bold text-dark mb-2">Đăng Nhập</h2>
                    <p class="text-muted small">Cổng thông tin đào tạo & đăng ký học phần</p>
                    <hr class="w-25 mx-auto text-secondary" />
                </div>

                <div class="alert alert-primary border-0 rounded-3 text-start small mb-4 bg-light text-primary">
                    <h6 class="alert-heading fw-bold mb-1"><i class="bi bi-info-circle-fill"></i> Tài khoản Demo:</h6>
                    <div class="mb-1"><strong>Tài khoản:</strong> <code>admin@course.com</code></div>
                    <div><strong>Mật khẩu:</strong> <code>Admin@123</code></div>
                </div>

                <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="form-floating mb-3">
                        <input type="email" name="email" class="form-control" id="emailInput" placeholder="name@example.com" required autocomplete="username">
                        <label for="emailInput" class="text-secondary">Địa chỉ Email</label>
                    </div>

                    <div class="form-floating mb-3">
                        <input type="password" name="password" class="form-control" id="passwordInput" placeholder="Mật khẩu" required autocomplete="current-password">
                        <label for="passwordInput" class="text-secondary">Mật khẩu</label>
                    </div>

                    <div class="form-check mb-4 text-start">
                        <input class="form-check-input" type="checkbox" name="rememberMe" id="rememberMeCheck" value="true">
                        <label class="form-check-label text-muted small" for="rememberMeCheck">
                            Ghi nhớ đăng nhập
                        </label>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-pill btn-lg shadow-sm">
                            Đăng nhập
                        </button>
                    </div>
                </form>

                <hr class="my-4 text-muted" />

                <form asp-action="ExternalLogin" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                    <div class="d-grid gap-2">
                        <button type="submit" name="provider" value="Google" class="btn btn-outline-danger btn-pill">
                            <i class="bi bi-google me-2"></i> Đăng nhập bằng Google
                        </button>
                    </div>
                </form>

                <div class="text-center mt-4">
                    <span class="text-muted small">Chưa có tài khoản? <a asp-action="Register" class="text-primary text-decoration-none fw-semibold">Đăng ký ngay</a></span>
                </div>
            </div>
        </div>
    </div>
</div>
